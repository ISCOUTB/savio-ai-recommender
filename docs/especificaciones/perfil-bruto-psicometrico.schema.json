{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savio.local/esquemas/perfil-bruto-psicometrico.schema.json",
  "title": "perfil_bruto_psicometrico_entrega_3",
  "description": "Perfil psicometrico con puntajes brutos nativos de los tres instrumentos. Reemplaza la escala unificada 1.0-5.0 y los indices compuestos de Entrega 2 (autonomia). Los invariantes que un JSON Schema no expresa (total CHASIDE = interes + aptitud, pares Felder-Silverman que suman 11, diferencial = polo izquierdo - polo derecho) lo verifica docs/especificaciones/validar-perfiles-brutos.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "origen", "chaside", "ils", "personalidad"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Identificador del perfil. En datos reales es un alias local (por ejemplo persona-1); en datos sinteticos usa SINT-###."
    },
    "origen": {
      "type": "string",
      "enum": ["real", "sintetico"],
      "description": "real = perfil local del equipo, nunca sale de la maquina. sintetico = corpus de entrenamiento."
    },
    "fecha_aplicacion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha de aplicacion de los tres instrumentos (AAAA-MM-DD), opcional."
    },
    "chaside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "H", "A", "S", "I", "D", "E"],
      "description": "Puntajes nativos por area vocacional: 10 items de interes y 4 de aptitud.",
      "properties": {
        "C": { "$ref": "#/$defs/area_chaside" },
        "H": { "$ref": "#/$defs/area_chaside" },
        "A": { "$ref": "#/$defs/area_chaside" },
        "S": { "$ref": "#/$defs/area_chaside" },
        "I": { "$ref": "#/$defs/area_chaside" },
        "D": { "$ref": "#/$defs/area_chaside" },
        "E": { "$ref": "#/$defs/area_chaside" }
      }
    },
    "ils": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activo",
        "reflexivo",
        "sensitivo",
        "intuitivo",
        "visual",
        "verbal",
        "secuencial",
        "global"
      ],
      "description": "Conteo nativo de Felder-Silverman: 11 items por dimension bipolar; cada par suma 11.",
      "properties": {
        "activo": { "type": "integer", "minimum": 0, "maximum": 11 },
        "reflexivo": { "type": "integer", "minimum": 0, "maximum": 11 },
        "sensitivo": { "type": "integer", "minimum": 0, "maximum": 11 },
        "intuitivo": { "type": "integer", "minimum": 0, "maximum": 11 },
        "visual": { "type": "integer", "minimum": 0, "maximum": 11 },
        "verbal": { "type": "integer", "minimum": 0, "maximum": 11 },
        "secuencial": { "type": "integer", "minimum": 0, "maximum": 11 },
        "global": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    },
    "diferencial": {
      "type": "object",
      "additionalProperties": false,
      "description": "Diferencial oficial por dimension: impar entre -11 y 11 (positivo hacia el polo izquierdo, negativo hacia el derecho). Es derivado de ils, no un puntaje nuevo.",
      "properties": {
        "activo_reflexivo": { "$ref": "#/$defs/diferencial" },
        "sensitivo_intuitivo": { "$ref": "#/$defs/diferencial" },
        "visual_verbal": { "$ref": "#/$defs/diferencial" },
        "secuencial_global": { "$ref": "#/$defs/diferencial" }
      }
    },
    "personalidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraversion",
        "introversion",
        "sensing",
        "intuition",
        "thinking",
        "feeling",
        "judging",
        "perceptive"
      ],
      "description": "Conteo nativo de los 8 polos (0-9). Sin indices compuestos: autonomia queda prohibida.",
      "properties": {
        "extraversion": { "type": "integer", "minimum": 0, "maximum": 9 },
        "introversion": { "type": "integer", "minimum": 0, "maximum": 9 },
        "sensing": { "type": "integer", "minimum": 0, "maximum": 9 },
        "intuition": { "type": "integer", "minimum": 0, "maximum": 9 },
        "thinking": { "type": "integer", "minimum": 0, "maximum": 9 },
        "feeling": { "type": "integer", "minimum": 0, "maximum": 9 },
        "judging": { "type": "integer", "minimum": 0, "maximum": 9 },
        "perceptive": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    }
  },
  "$defs": {
    "area_chaside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interes", "aptitud", "total"],
      "properties": {
        "interes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Suma de los 10 items de interes del area."
        },
        "aptitud": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Suma de los 4 items de aptitud del area."
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14,
          "description": "Debe ser exactamente interes + aptitud."
        }
      }
    },
    "diferencial": {
      "type": "integer",
      "enum": [-11, -9, -7, -5, -3, -1, 1, 3, 5, 7, 9, 11]
    }
  }
}
