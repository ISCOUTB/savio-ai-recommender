{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "perfil_estudiante_entrega_2",
  "type": "object",
  "required": ["estudiante_id", "origen", "estilos_aprendizaje", "personalidad", "chaside"],
  "additionalProperties": false,
  "properties": {
    "estudiante_id": {
      "type": "string",
      "minLength": 1
    },
    "origen": {
      "type": "string",
      "enum": ["real", "simulado"]
    },
    "estilos_aprendizaje": {
      "type": "object",
      "required": ["modelo", "puntajes", "preferencias", "descripcion_para_prompt"],
      "additionalProperties": false,
      "properties": {
        "modelo": {
          "type": "string",
          "enum": ["vak", "felder_silverman", "kolb", "otro"]
        },
        "puntajes": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": { "type": "number", "minimum": 1.0, "maximum": 5.0 }
        },
        "preferencias": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["activo", "reflexivo", "sensorial", "intuitivo", "visual", "verbal", "secuencial", "global"]
          },
          "uniqueItems": true,
          "maxItems": 4
        },
        "descripcion_para_prompt": {
          "type": "string"
        }
      }
    },
    "personalidad": {
      "type": "object",
      "required": ["rasgos"],
      "additionalProperties": false,
      "properties": {
        "rasgos": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 1.0, "maximum": 5.0 }
        },
        "resumen_conductual": {
          "type": "string"
        },
        "preferencias_trabajo": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "chaside": {
      "type": "object",
      "required": ["areas"],
      "additionalProperties": false,
      "properties": {
        "areas": {
          "type": "object",
          "required": ["C", "H", "A", "S", "I", "D", "E"],
          "properties": {
            "C": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "H": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "A": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "S": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "I": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "D": { "type": "number", "minimum": 1.0, "maximum": 5.0 },
            "E": { "type": "number", "minimum": 1.0, "maximum": 5.0 }
          },
          "additionalProperties": false
        },
        "areas_dominantes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["C", "H", "A", "S", "I", "D", "E"]
          }
        },
        "descripcion_para_analogias": {
          "type": "string"
        }
      }
    }
  }
}
