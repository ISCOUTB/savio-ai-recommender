<div class="block_chaside_container">
    <h1 class="mb-4 text-center">
        <img src="{{{plugin_icon_url}}}" alt="CHASIDE Icon" style="width: 50px; height: 50px; vertical-align: middle; margin-right: 15px;" />
        {{title}}
    </h1>
    <div class="alert alert-info mb-4">
        {{{ description }}}
    </div>

    {{#delete_confirmation}}
    <div class="alert alert-warning">
        <h4>{{#str}}confirm_delete, block_chaside{{/str}}</h4>
        <p>{{confirm_message}}</p>
        <div class="mt-3">
            <a href="{{confirm_url}}" class="btn btn-danger">{{#str}}confirm_delete_yes, block_chaside{{/str}}</a>
            <a href="{{cancel_url}}" class="btn btn-secondary text-white">{{#str}}cancel{{/str}}</a>
        </div>
    </div>
    {{/delete_confirmation}}

    {{^delete_confirmation}}
    <div class="row mb-4">
        <div class="col-md-3 mb-4">
            <div class="card border-info" style="border-color: #ffb600 !important;">
                <div class="card-body text-center">
                    <i class="fa fa-users text-primary" style="font-size: 2em; margin-bottom: 10px;"></i>
                    <h5 class="card-title">{{#str}}enrolled_students, block_chaside{{/str}}</h5>
                    <h2 class="text-primary">{{total_enrolled}}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-success" style="border-color: #28a745 !important;">
                <div class="card-body text-center">
                    <i class="fa fa-check-circle text-success" style="font-size: 2em; margin-bottom: 10px;"></i>
                    <h5 class="card-title">{{#str}}total_completed, block_chaside{{/str}}</h5>
                    <h2 class="text-success">{{total_completed}}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-warning" style="border-color: #ffc107 !important;">
                <div class="card-body text-center">
                    <i class="fa fa-hourglass-half text-warning" style="font-size: 2em; margin-bottom: 10px;"></i>
                    <h5 class="card-title">{{#str}}in_progress, block_chaside{{/str}}</h5>
                    <h2 class="text-warning">{{total_in_progress}}</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-primary" style="border-color: #ffb600 !important;">
                <div class="card-body text-center">
                    <i class="fa fa-percent text-primary" style="font-size: 2em; margin-bottom: 10px;"></i>
                    <h5 class="card-title">{{#str}}completion_rate, block_chaside{{/str}}</h5>
                    <h2 class="text-primary">{{completion_rate}}%</h2>
                </div>
            </div>
        </div>
    </div>

    {{#has_completed}}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fa fa-chart-bar"></i> {{#str}}average_dimensions, block_chaside{{/str}}</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        {{#area_averages}}
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="card chaside-area-avg-card h-100">
                                <div class="card-body">
                                    <h6 class="mb-2">{{code}} - {{name}}</h6>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <small class="text-muted">{{#str}}average_score, block_chaside{{/str}}:</small>
                                        <strong class="chaside-area-avg-score">{{avg_score}}/14</strong>
                                    </div>
                                    <div class="progress mb-1">
                                        <div class="progress-bar" style="width: {{progress_width}}%;"></div>
                                    </div>
                                    <small class="text-muted">{{preference_percentage}}% {{#str}}preference, block_chaside{{/str}}</small>
                                </div>
                            </div>
                        </div>
                        {{/area_averages}}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fa fa-trophy"></i> {{#str}}top_areas_distribution, block_chaside{{/str}}</h5>
                </div>
                <div class="card-body">
                    <h6 class="mb-3">{{#str}}primary_area_title, block_chaside{{/str}}</h6>
                    <div class="row">
                        {{#top1_areas}}
                        <div class="col-lg-3 col-md-4 mb-3">
                            <div class="card h-100 shadow-sm" style="border-left: 4px solid #ffb600;">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 mr-3">
                                            <i class="fa {{icon}} fa-2x" style="color: #ffb600;"></i>
                                        </div>
                                        <div class="flex-grow-1" style="hyphens: auto; word-break: break-word;">
                                            <h4 class="mb-0">{{count}} <small class="text-muted" style="font-size: 0.5em;">({{percentage}}%)</small></h4>
                                            <div class="small text-muted font-weight-bold" style="line-height: 1.2;">{{code}} - {{name}}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/top1_areas}}
                    </div>

                    <hr>

                    <h6 class="mb-3 mt-4">{{#str}}secondary_area_title, block_chaside{{/str}}</h6>
                    <div class="row">
                        {{#top2_areas}}
                        <div class="col-lg-3 col-md-4 mb-3">
                            <div class="card h-100 shadow-sm" style="border-left: 4px solid #6c757d;">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="flex-shrink-0 mr-3">
                                            <i class="fa {{icon}} fa-2x text-secondary"></i>
                                        </div>
                                        <div class="flex-grow-1" style="hyphens: auto; word-break: break-word;">
                                            <h4 class="mb-0">{{count}} <small class="text-muted" style="font-size: 0.5em;">({{percentage}}%)</small></h4>
                                            <div class="small text-muted font-weight-bold" style="line-height: 1.2;">{{code}} - {{name}}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/top2_areas}}
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{/has_completed}}


    <div id="chaside-results-region">
    {{#show_table}}
        <div class="card mt-5" id="participants-container">
            <div class="card-header">
                <h5 class="mb-0">{{#str}}student_responses, block_chaside{{/str}}</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3 w-100 mx-0">
                    <div class="col-md-9 pl-0 pr-0 pr-md-2">
                        <form id="searchForm" method="get" action="{{admin_url}}" onsubmit="return false;" style="width: 100%;">
                            <input type="hidden" name="courseid" value="{{courseid}}">
                            <div class="input-group" style="width: 100%;">
                                <input type="text" name="search" id="searchInput" class="form-control" placeholder="{{#str}}search_student, block_chaside{{/str}}" value="{{search_term}}" autocomplete="off">
                            </div>
                         </form>
                    </div>
                    <div class="col-md-3 text-end d-flex justify-content-center justify-content-md-end mt-3 mt-md-0 pr-0 pl-0 pl-md-2">
                         <a href="{{export_url}}" class="btn btn-success w-100"><i class="fa fa-download mr-2"></i>{{#str}}download_csv, block_chaside{{/str}}</a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>{{#str}}student, block_chaside{{/str}}</th>
                                <th>{{#str}}email{{/str}}</th>
                                <th>{{#str}}completion_status, block_chaside{{/str}}</th>
                                <th>{{#str}}top_area, block_chaside{{/str}}</th>
                                <th>{{#str}}completiondate, block_chaside{{/str}}</th>
                                <th>{{#str}}actions, block_chaside{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#list}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {{{userpicture}}}
                                        <span class="ms-2"><strong>{{fullname}}</strong></span>
                                    </div>
                                </td>
                                <td>{{email}}</td>
                                <td>
                                    {{#is_completed}}
                                    <span class="badge bg-success text-white">{{#str}}completed_status, block_chaside{{/str}}</span>
                                    {{/is_completed}}
                                    {{^is_completed}}
                                    <span class="badge bg-warning text-dark">{{#str}}in_progress_status, block_chaside{{/str}}</span>
                                    <br><small class="text-muted">{{answered}}/98 {{#str}}questions, block_chaside{{/str}}</small>
                                    {{/is_completed}}
                                </td>
                                <td>
                                    {{#top_area}}
                                    <strong>{{code}} - {{name}}</strong>
                                    {{/top_area}}
                                    {{^top_area}}<span class="text-muted">-</span>{{/top_area}}
                                </td>
                                <td>{{date_completed}}</td>
                                <td>
                                    <a href="{{view_url}}" class="btn btn-sm btn-info mr-2 mt-1 mb-1" title="{{#str}}viewresults, block_chaside{{/str}}">
                                        <i class="fa fa-eye"></i> {{#str}}view, block_chaside{{/str}}
                                    </a>
                                    {{#can_delete}}
                                        <a href="{{delete_url}}" class="btn btn-sm btn-danger" title="{{#str}}deleteresponse, block_chaside{{/str}}">
                                            <i class="fa fa-trash"></i> {{#str}}delete{{/str}}
                                        </a>
                                    {{/can_delete}}
                                </td>
                            </tr>
                            {{/list}}
                            {{^list}}
                            <tr>
                                <td colspan="6" class="text-center p-4">
                                    <div class="alert alert-warning mb-0">
                                        <i class="fa fa-exclamation-triangle mr-2"></i> {{#str}}no_results_search, block_chaside, {{search_term}}{{/str}}
                                    </div>
                                </td>
                            </tr>
                            {{/list}}
                        </tbody>
                    </table>
                </div>
                 
                 <!-- Pagination -->
                 <div class="mt-3 d-flex justify-content-center">
                    {{{pagination}}}
                 </div>

            </div>
        </div>
    {{/show_table}}
    {{^show_table}}
        <div class="alert alert-info mt-4">
            <i class="fa fa-info-circle"></i> 
            <h5>{{#str}}no_responses_found, block_chaside{{/str}}</h5>
            <p>{{#str}}no_participants_message, block_chaside{{/str}}</p>
        </div>
    {{/show_table}}
    </div>
    {{/delete_confirmation}}

    <div class="mt-4 text-center">
        <a href="{{course_url}}" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> {{#str}}back_to_course, block_chaside{{/str}}
        </a>
    </div>
</div>
{{#js}}
require(['jquery'], function($) {
    var timeout = null;
    var container = $('#chaside-results-region');

    // Dynamic Search (AJAX)
    // We delegate the event to container because in some states (reloads), we might want to ensure listener persists, 
    // BUT the search input is part of the re-loaded content in my template logic slightly above, 
    // actually, the search input IS inside the #participants-container.
    // If we replace #participants-container, we lose the element and the binding.
    // 
    // SOLUTION: Use event delegation ON A PARENT THAT DOES NOT CHANGE.
    // #chaside-results-region contains everything.
    
    container.on('input', '#searchInput', function() {
        var input = $(this);
        if (timeout) clearTimeout(timeout);
        var searchTerm = input.val();
        
        timeout = setTimeout(function() {
            loadResults(searchTerm, 0); 
        }, 300);
    });
    
    // Similarly for pagination
    container.on('click', '.pagination a', function(e) {
        e.preventDefault();
        var href = $(this).attr('href');
        if (!href) return;
        
        var urlParams = new URLSearchParams(href.split('?')[1]);
        var page = urlParams.get('page') || 0;
        var searchTerm = container.find('#searchInput').val() || ''; // Find current input value
        
        loadResults(searchTerm, page);
    });

    function loadResults(search, page) {
        var url = '{{admin_url}}';
        var data = {
            courseid: {{courseid}},
            search: search,
            page: page,
            action: 'list'
        };

        // Opacity effect
        container.css('opacity', '0.6');

        $.get(url, data, function(response) {
            // New logic: Replace the WHOLE region content
            // The server returns the full page. We need to extract the content of #chaside-results-region
            
            var responseObj = $('<div>').html(response);
            var newContent = responseObj.find('#chaside-results-region').html();
            
            if (newContent) {
                container.html(newContent);
                
                // Restore Focus:
                var input = container.find('#searchInput');
                if (input.length) {
                    input.focus();
                    // Move cursor to end
                    var tmpStr = input.val();
                    input.val('');
                    input.val(tmpStr);
                }
            } else {
                 // Fallback if partial update fails or structure changes (just in case)
                 // Perhaps reload page or log error
            }
            
            container.css('opacity', '1');
        });
    }
});
{{/js}}
